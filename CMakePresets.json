{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022-x64-debug",
      "displayName": "Visual Studio 2022 x64 Debug (Qt 5.15.2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HTMSR_BUILD_CAPTURE_TESTS": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "vs2022-x64-release",
      "displayName": "Visual Studio 2022 x64 Release (Qt 5.15.2)",
      "inherits": "vs2022-x64-debug",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-x64-debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-x64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "vs2022-x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "verify-debug",
      "steps": [
        {
          "type": "configure",
          "name": "vs2022-x64-debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "verify-release",
      "steps": [
        {
          "type": "configure",
          "name": "vs2022-x64-release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    }
  ]
}
