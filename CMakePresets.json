{
  "version": 5,
  "configurePresets": [
    {
      "name": "vs2022-x64-debug",
      "displayName": "Visual Studio 2022 x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HTMSR_ENABLE_VTK_VIEWER": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "vs2022-x64-release",
      "displayName": "Visual Studio 2022 x64 Release",
      "inherits": "vs2022-x64-debug",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HTMSR_ENABLE_VTK_VIEWER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-x64-debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022-x64-release"
    }
  ]
}
